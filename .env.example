# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Local dev: `pnpm db:start` prints these. Production: Supabase dashboard →
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — must NEVER be exposed to a client bundle.
# Used solely by /api/admin/* and /api/verify/[token].
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 --------------------------------------------------------
# Cloudflare dashboard → R2 → Manage API Tokens.
# Server-only: clients receive presigned URLs, never these credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pioneers-egy

# --- App ------------------------------------------------------------------
# Public origin, used to build certificate QR/verify links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Expo mobile ----------------------------------------------------------
# Mirrors of the public values above. EXPO_PUBLIC_* is inlined into the app
# bundle, so only ever put public values here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where the Next.js route handlers live. On a physical device this must be your
# machine's LAN IP (e.g. http://192.168.1.20:3000), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
