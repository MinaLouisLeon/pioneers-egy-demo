# Expo / React Native require a hoisted node_modules layout — Metro does not
# follow pnpm's symlinked store reliably, and native autolinking breaks without this.
node-linker=hoisted

# Keep peer deps from failing installs across the web/native boundary
strict-peer-dependencies=false
auto-install-peers=true

# React Native pulls a lot of large tarballs; the defaults are too aggressive
# on a slow or flaky connection.
fetch-timeout=180000
fetch-retries=5
fetch-retry-maxtimeout=120000
network-concurrency=8
